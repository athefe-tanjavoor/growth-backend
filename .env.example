# ==============================================================================
# Growthanalys Centralized Backend Environment Configuration
# ==============================================================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Security & Secrets
JWT_SECRET=replace_with_a_super_strong_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_super_strong_jwt_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_cookie_secret_string

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/growthanalys_admin

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://growthanalys.com,https://admin.growthanalys.com

# Cloudflare R2 (S3-compatible) Media Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public CDN URL for assets (e.g. https://media.growthanalys.com or https://pub-xxx.r2.dev)
R2_PUBLIC_URL=
R2_ENDPOINT=

# Admin Initial Seed (Optional: leave empty to skip automatic seeding)
ADMIN_INITIAL_NAME=
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
